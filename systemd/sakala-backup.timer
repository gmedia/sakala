# Installed by install.sh as /etc/systemd/system/sakala-backup.timer.
#
# 02:00 WIB (UTC+7). Persistent=true runs a missed backup as soon as the server
# is back, so a reboot over the schedule costs minutes rather than a day.
[Unit]
Description=Back up Sakala daily

[Timer]
OnCalendar=*-*-* 19:00:00 UTC
RandomizedDelaySec=15min
Persistent=true
Unit=sakala-backup.service

[Install]
WantedBy=timers.target
