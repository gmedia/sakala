# Rendered by install.sh and upgrade.sh. The Console image (v0.5.0 and newer) reads
# these when its container starts and replaces the hosted Sakala values it was built
# with, so the browser calls this installation's API. Public values only: the browser
# sees all of them. PUBLIC_REVERB_KEY is Reverb's public app key, never its secret.
PUBLIC_API_URL=https://api.${SAKALA_DOMAIN}
PUBLIC_APP_URL=https://app.${SAKALA_DOMAIN}
PUBLIC_REVERB_HOST=api.${SAKALA_DOMAIN}
PUBLIC_REVERB_PORT=443
PUBLIC_REVERB_SCHEME=https
PUBLIC_REVERB_KEY=${SAKALA_REVERB_APP_KEY}
