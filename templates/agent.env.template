# Rendered by install.sh and upgrade.sh for sakala-agent.service. Edits here are
# overwritten. The agent id and token live in secrets/agent-credentials.env.
# Names follow sakala-agent docs/CONFIGURATION.md; unknown names are ignored.
SAKALA_AGENT_MODE=connected
# The API over loopback, so the agent does not depend on public DNS or TLS.
SAKALA_API_URL=http://127.0.0.1:${SAKALA_API_LOOPBACK_PORT}
SAKALA_POLL_INTERVAL_SECONDS=3
SAKALA_HEARTBEAT_INTERVAL_SECONDS=10
SAKALA_SHUTDOWN_GRACE_SECONDS=30
SAKALA_LOG_LEVEL=info

SAKALA_RUNTIME_DRIVER=docker
SAKALA_RUNTIME_NETWORK=sakala-runtime
SAKALA_RUNTIME_WORKSPACE=${SAKALA_STATE_DIR}/builds
SAKALA_MIN_WORKSPACE_FREE_MB=1024
SAKALA_CADDY_SITES_DIR=${SAKALA_STATE_DIR}/caddy/sites
SAKALA_CADDY_CONTAINER=sakala-caddy
SAKALA_RAILPACK_FRONTEND=${SAKALA_RAILPACK_FRONTEND}
SAKALA_RAILPACK_IMAGE=${SAKALA_RAILPACK_IMAGE}

# Every project runs under gVisor. Without a registered runsc the agent refuses
# to start rather than fall back. Workloads under runsc need explicit DNS.
SAKALA_CONTAINER_RUNTIME=runsc
SAKALA_CONTAINER_DNS=1.1.1.1,8.8.8.8

# Node ceilings for a 2 vCPU, 4 GB server that also runs the control plane.
# The API sends per-deployment limits; the agent refuses anything above these.
SAKALA_MAX_CONCURRENT_COMMANDS=2
SAKALA_MAX_CONCURRENT_BUILDS=1
SAKALA_MAX_ACTIVE_CONTAINERS=${SAKALA_MAX_ACTIVE_CONTAINERS}
SAKALA_COMMAND_TIMEOUT_SECONDS=900
SAKALA_BUILD_TIMEOUT_SECONDS=600
SAKALA_START_TIMEOUT_SECONDS=120
SAKALA_DEFAULT_CONTAINER_MEMORY_MB=256
SAKALA_MAX_CONTAINER_MEMORY_MB=512
SAKALA_DEFAULT_CONTAINER_CPU_MILLIS=500
SAKALA_MAX_CONTAINER_CPU_MILLIS=1000
SAKALA_DEFAULT_CONTAINER_PIDS_LIMIT=128
SAKALA_MAX_CONTAINER_PIDS_LIMIT=256
SAKALA_WORKSPACE_GC_MAX_AGE_SECONDS=86400
SAKALA_IMAGE_GC_MAX_AGE_SECONDS=604800
