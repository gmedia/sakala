# Your settings for the API, read after api.env and winning over it. install.sh
# writes this file once and never changes it again. Restart after editing:
#   sudo sakala-compose up -d
#
# Email (needed before other people can verify their address or reset a password):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@example.com
#
# GitHub App (docs/configuration.md):
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=
#
# Read-only token for public repositories, so GitHub's anonymous limit of 60
# requests per hour does not apply:
# GITHUB_PUBLIC_API_TOKEN=
