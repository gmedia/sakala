# Rendered by install.sh and upgrade.sh from templates/api.env.template. Edits here
# are overwritten; put your own settings (SMTP, GitHub App, Google login) in
# api.local.env next to this file, which wins over this one.
APP_NAME="Sakala"
APP_ENV=production
APP_KEY=${SAKALA_APP_KEY}
APP_DEBUG=false
APP_URL=https://api.${SAKALA_DOMAIN}
SAKALA_CONSOLE_URL=https://app.${SAKALA_DOMAIN}
SAKALA_API_VERSION=v1
SCRAMBLE_ENABLED=false

# Project URLs are https://<name>.run.<domain>, which the edge serves. The agent's
# SAKALA_PROJECT_DOMAIN_SUFFIXES gets the same value, or it refuses every deployment.
SAKALA_PROJECT_DEFAULT_DOMAIN=${SAKALA_PROJECT_DOMAIN}
SAKALA_SIMULATE_DEPLOYMENTS=false

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sakala_api
DB_USERNAME=sakala
DB_PASSWORD=${SAKALA_DB_PASSWORD}

SESSION_DRIVER=database
# Host-only on api.<domain>, so it never reaches projects under run.<domain>.
SESSION_COOKIE=__Host-sakala-api-session
SESSION_DOMAIN=
# The console reads this cookie from JavaScript on app.<domain>.
SAKALA_XSRF_COOKIE_DOMAIN=.${SAKALA_DOMAIN}
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.${SAKALA_DOMAIN},api.${SAKALA_DOMAIN}
CORS_ALLOWED_ORIGINS=https://app.${SAKALA_DOMAIN}

CACHE_STORE=redis
CACHE_PREFIX=sakala_api_cache
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Avatars in RustFS. AWS_URL is what browsers load them from, through the edge.
AWS_ACCESS_KEY_ID=${SAKALA_STORAGE_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${SAKALA_STORAGE_SECRET_KEY}
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sakala
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=https://api.${SAKALA_DOMAIN}/storage/sakala

REVERB_APP_ID=${SAKALA_REVERB_APP_ID}
REVERB_APP_KEY=${SAKALA_REVERB_APP_KEY}
REVERB_APP_SECRET=${SAKALA_REVERB_APP_SECRET}
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=app.${SAKALA_DOMAIN}
REVERB_SCALING_ENABLED=false

# `log` writes verification and password reset emails to the API log only. Set a
# real mailer in api.local.env before other people sign up (docs/configuration.md).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@${SAKALA_DOMAIN}
MAIL_FROM_NAME="Sakala"
SAKALA_ABUSE_EMAIL=${SAKALA_ADMIN_EMAIL}
SAKALA_PRIVACY_EMAIL=${SAKALA_ADMIN_EMAIL}

# GitHub App: optional, empty until configured in api.local.env (docs/configuration.md).
# Without it, people deploy public repositories by URL.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
GITHUB_APP_REDIRECT_URI=https://api.${SAKALA_DOMAIN}/auth/github/callback
GITHUB_APP_SETUP_URI=https://api.${SAKALA_DOMAIN}/auth/github/setup
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_PUBLIC_API_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.${SAKALA_DOMAIN}/auth/google/callback
