# Settings for scripts/backup.sh. install.sh writes this file once; edit it freely.
# Every value shows its default. It holds paths and limits, never a private key.

# One age public key per line. The matching private key must never reach this server.
BACKUP_AGE_RECIPIENTS_FILE=${SAKALA_SECRETS_DIR}/backup.age-recipients
BACKUP_DIR=${SAKALA_STATE_DIR}/backups
BACKUP_KEEP=14
BACKUP_MIN_FREE_MB=2048
BACKUP_MAX_AGE_HOURS=26
BACKUP_POSTGRES_CONTAINER=sakala-postgres-1
BACKUP_API_CONTAINER=sakala-api-1
BACKUP_PG_LOCK_TIMEOUT=300s
BACKUP_RUSTFS_CONTAINER=sakala-rustfs-1
BACKUP_SECRETS_DIR=${SAKALA_SECRETS_DIR}

# Optional off-host copy through rsync over SSH, for example to a second server
# whose key is locked to one directory with rrsync. Empty means off.
BACKUP_REMOTE=
BACKUP_REMOTE_KEY=${SAKALA_SECRETS_DIR}/backup-remote.ed25519
BACKUP_REMOTE_KNOWN_HOSTS=${SAKALA_SECRETS_DIR}/backup-remote.known_hosts
BACKUP_REMOTE_PORT=22
