# What a Sakala installation runs. install.sh and upgrade.sh read this file, and
# a release of this repository is a change to it: check out a newer tag, then run
# upgrade.sh.
#
# Every image is pinned by digest, never by tag. A tag can be moved to different
# content, a digest cannot, so what was tested is exactly what runs. The scripts
# refuse an image reference without @sha256:. The human-readable version sits next
# to each pin.
#
# Get the digest of a release:
#   docker buildx imagetools inspect ghcr.io/gmedia/sakala-api:vX.Y.Z --format '{{.Manifest.Digest}}'

# Sakala components, mirroring the hosted production release of 2026-11-11.
SAKALA_API_VERSION=v0.3.0
SAKALA_API_IMAGE=ghcr.io/gmedia/sakala-api@sha256:c246fa07a20b249da396113c0855cda28de08ac37d1ce48a5892b19e46308b5a
SAKALA_API_WEB_IMAGE=ghcr.io/gmedia/sakala-api-web@sha256:5b5f94ac60b71af1cb616eb1e784c027fbe8ae1347944c87b61c7f6af45b0677

# v0.4.0 bakes the hosted API into its bundle and cannot be pointed elsewhere.
# Self-hosting needs the first Console release that reads PUBLIC_* when the
# container starts (gmedia/sakala-console#98). Until this pin moves there,
# install.sh stops with a message after starting the Console.
SAKALA_CONSOLE_VERSION=v0.4.0
SAKALA_CONSOLE_IMAGE=ghcr.io/gmedia/sakala-console@sha256:ad0c79004154fdf5449384a92ef27b17ec72140361f5ca28a0d69854a73f04e8

# Third-party images.
# postgres:17-alpine
SAKALA_POSTGRES_IMAGE=postgres@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
# valkey/valkey:9-alpine
SAKALA_VALKEY_IMAGE=valkey/valkey@sha256:48332870af354a799964c0012ae1194a0bf2bf894eb508f945810596dc2d8d11
# rustfs/rustfs:1.0.0
SAKALA_STORAGE_IMAGE=rustfs/rustfs@sha256:8cc9801755448b71a786705ce76692c77e14936cccd87cf2fc31842e58f4d1ff
# caddy:2.11.3-alpine, for both the public edge and the runtime router. The
# runtime router must keep BusyBox wget, which the agent's readiness probe runs.
SAKALA_CADDY_IMAGE=caddy@sha256:86deaf5e3d3408a6ccec08fbb79989783dd26e206ae10bcf78a801dc8c9ab794
# caddy/Dockerfile.dns pins caddy:2.11.3-builder-alpine itself, so Dependabot can
# move it; keep it on the same Caddy version as SAKALA_CADDY_IMAGE.

# Sakala Agent, a host binary. The installer checks the download against the
# release's SHA256SUMS and against SAKALA_AGENT_SHA256, so a replaced release
# asset is refused even if its SHA256SUMS was replaced too. The Railpack sandbox
# image is built on the server from the agent source at SAKALA_AGENT_COMMIT,
# the commit that tag pointed to when this pin was made.
SAKALA_AGENT_VERSION=v0.5.0
SAKALA_AGENT_SHA256=8833b9e16b52904a70c7a2657c85821fd429a319fdb564ab5819aa890bda5736
SAKALA_AGENT_COMMIT=0f5777ec5c2c99834bc7ccae02e8f2edf2218b7f
SAKALA_RAILPACK_FRONTEND=ghcr.io/railwayapp/railpack-frontend:v0.23.0

# gVisor, which runs every deployed project (runsc, systrap platform). Checked
# against the release's .sha512 and against this pin.
SAKALA_GVISOR_RELEASE=20261102.0
SAKALA_GVISOR_SHA512=3c400f72be459b57b99b1c4f69be96bcd67eef3caf2078e595fc98e688b6b9a3af7802646b3dde7da8a9aba96d34f86be303e0430c7868ab2d13becdd403c0c1
