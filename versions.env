# What a Sakala installation runs. install.sh and upgrade.sh read this file, and
# a release of this repository is a change to it: check out a newer tag, then run
# upgrade.sh.
#
# Every image is pinned by digest, never by tag. A tag can be moved to different
# content, a digest cannot, so what was tested is exactly what runs. The scripts
# refuse an image reference without @sha256:. The human-readable version sits next
# to each pin.
#
# Get the digest of a release:
#   docker buildx imagetools inspect ghcr.io/gmedia/sakala-api:vX.Y.Z --format '{{.Manifest.Digest}}'

# Sakala components, the releases of 2026-11-24. The Console reads PUBLIC_* when its
# container starts (console.env), so one published image serves any domain. Since
# v0.6.0 the API defaults SAKALA_PROJECT_DEFAULT_DOMAIN to hosted Sakala's
# sakala.app, so templates/api.env.template always sets it to run.<domain>.
SAKALA_API_VERSION=v0.12.0
SAKALA_API_IMAGE=ghcr.io/gmedia/sakala-api@sha256:b275c2f4c6d33fc9d4f144020fd50ee526374c686aaa083aa40165bc7c0691de
SAKALA_API_WEB_IMAGE=ghcr.io/gmedia/sakala-api-web@sha256:479e8f00b3313376b4b4ab3f2c63a3fa0473506ee579d9f3fad332214c5a03c8

SAKALA_CONSOLE_VERSION=v0.13.0
SAKALA_CONSOLE_IMAGE=ghcr.io/gmedia/sakala-console@sha256:63e8165aa5775e97a1636bf1bb236c957943fb56ead3702e1fd6c9e5d9b6b482

# Third-party images.
# postgres:17-alpine
SAKALA_POSTGRES_IMAGE=postgres@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
# valkey/valkey:9-alpine
SAKALA_VALKEY_IMAGE=valkey/valkey@sha256:48332870af354a799964c0012ae1194a0bf2bf894eb508f945810596dc2d8d11
# rustfs/rustfs:1.0.0
SAKALA_STORAGE_IMAGE=rustfs/rustfs@sha256:8cc9801755448b71a786705ce76692c77e14936cccd87cf2fc31842e58f4d1ff
# caddy:2.11.9-alpine, for both the public edge and the runtime router. The
# runtime router must keep BusyBox wget and nc, which the agent's readiness probe
# and its host check (agent v0.13.0 and newer) run.
SAKALA_CADDY_IMAGE=caddy@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
# caddy/Dockerfile.dns pins caddy:2.11.9-builder-alpine itself, so Dependabot can
# move it; keep it on the same Caddy version as SAKALA_CADDY_IMAGE.

# Sakala Agent, a host binary. The installer checks the download against the
# release's SHA256SUMS and against SAKALA_AGENT_SHA256, so a replaced release
# asset is refused even if its SHA256SUMS was replaced too. The Railpack sandbox
# image is built on the server from the agent source at SAKALA_AGENT_COMMIT,
# the commit that tag pointed to when this pin was made. The agent deploys only
# under the suffixes in SAKALA_PROJECT_DOMAIN_SUFFIXES, which install.sh sets to
# run.<domain>, the API's SAKALA_PROJECT_DEFAULT_DOMAIN. Without it, v0.8.0 and
# newer accept only hosted Sakala's domains (sakala.app, staging.sakala.app) and
# run.sakala.localhost. The release also carries sakala-edge, which a single
# server does not need and install.sh does not install (README.md).
# The agent's managed PostgreSQL role (v0.12.0) stays off: SAKALA_DATABASE_DRIVER
# is left at none, and api.env sets SAKALA_DATABASE_DEFAULT_MAX_COUNT=0
# (docs/configuration.md, "Database terkelola").
# The managed object storage role (v0.17.0) stays off too: SAKALA_OBJECT_STORAGE_DRIVER
# is left unset, so the agent does not advertise managed-s3.
SAKALA_AGENT_VERSION=v0.17.0
SAKALA_AGENT_SHA256=70afdfcbb8796c66d4c042040cad793ffbb0278cabac14c7fa69d5c188353dff
SAKALA_AGENT_COMMIT=1a57ad274e93042577281e21616e194efa421f4c
SAKALA_RAILPACK_FRONTEND=ghcr.io/railwayapp/railpack-frontend:v0.23.0

# gVisor, which runs every deployed project (runsc, systrap platform). Checked
# against the release's .sha512 and against this pin. What one project may write
# to its root filesystem is capped by SAKALA_GVISOR_OVERLAY_SIZE in sakala.env
# (1g unless changed; docs/configuration.md).
SAKALA_GVISOR_RELEASE=20261102.0
SAKALA_GVISOR_SHA512=3c400f72be459b57b99b1c4f69be96bcd67eef3caf2078e595fc98e688b6b9a3af7802646b3dde7da8a9aba96d34f86be303e0430c7868ab2d13becdd403c0c1
