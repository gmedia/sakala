{
	# The agent reaches the admin endpoint only through `docker exec`. Port 2019 is
	# not published to the host or any network.
	admin localhost:2019
	auto_https off

	# Request counters per project host. The agent reads them from the admin
	# endpoint to put idle projects to sleep when the operator enables it
	# (SAKALA_PROJECT_IDLE_SLEEP_MINUTES). Never published or exported.
	metrics {
		per_host
	}

	# Only the public edge may vouch for the visitor. It terminates TLS and sets
	# X-Forwarded-For, -Proto, and -Host from its TCP connection, so the router
	# keeps those headers only when they come from the edge's address and
	# overwrites them for any other peer.
	#
	# SAKALA_RUNTIME_TRUSTED_PROXIES is the subnet of the sakala-runtime network,
	# which holds only the edge and this router (docs/configuration.md). Never
	# trust private_ranges or another broad range: the agent connects this router
	# to every project's network, so a workload could then send a forged
	# X-Forwarded-For to another project's app, for example to get around a rate
	# limit per IP address. An empty value trusts nobody.
	#
	# trusted_proxies_strict reads X-Forwarded-For from right to left, so a value
	# a client put at the left is never taken as the client address.
	servers {
		trusted_proxies static {$SAKALA_RUNTIME_TRUSTED_PROXIES}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

# The agent writes one validated route per project into this read-only mount,
# then validates and reloads this container.
import /etc/caddy/sites/*.Caddyfile

:80 {
	handle /healthz {
		respond "ok" 200
	}

	# An unknown hostname must never look deployed. The header lets the edge tell
	# this answer apart from a project's own 404 when deciding whether a hostname
	# may get a certificate (caddy/edge.Caddyfile). Visitors get a small page that
	# never repeats the hostname, links the project's owner to the Console at
	# app.<domain>, loads nothing from elsewhere, and is never cached.
	handle {
		header {
			X-Sakala-Route missing
			Content-Type "text/html; charset=utf-8"
			Cache-Control "no-store"
			X-Robots-Tag "noindex"
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"
		}
		respond <<NOT_FOUND
			<!doctype html>
			<html lang="id">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width,initial-scale=1">
			<meta name="robots" content="noindex">
			<meta name="theme-color" content="#08413D">
			<title>Belum ada aplikasi di alamat ini</title>
			<style>
			*{box-sizing:border-box}
			html{height:100%}
			body{min-height:100%;margin:0;display:flex;flex-direction:column;background:#08413D;color:#fff;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5}
			main,footer{width:100%;max-width:34rem;margin:0 auto;padding-inline:1.5rem}
			main{flex:1;display:flex;flex-direction:column;justify-content:center;padding-block:3rem 2rem}
			h1{margin:0 0 .75rem;font-size:1.75rem;line-height:1.25;font-weight:700;text-wrap:balance}
			p{margin:0 0 1rem}
			.lead{font-size:1.0625rem}
			.hint{color:#B5D5D2;font-size:.9375rem}
			a{color:#CCFBF1;text-decoration:underline;text-underline-offset:.2em}
			a:hover{text-decoration-thickness:2px}
			:focus-visible{outline:2px solid #CCFBF1;outline-offset:3px}
			footer{display:flex;align-items:center;gap:.5rem;padding-block:1rem 1.5rem;color:#B5D5D2;font-size:.875rem}
			footer svg{flex:none;width:auto;height:24px}
			</style>
			</head>
			<body>
			<main>
			<h1>Belum ada aplikasi di alamat ini</h1>
			<p class="lead">Periksa lagi ejaan alamatnya. Bisa juga aplikasinya belum di-deploy atau sudah dihapus.</p>
			<p class="hint">Kalau ini alamat proyekmu, cek status deployment-nya di <a href="https://app.{$SAKALA_DOMAIN}">Console Sakala</a>.</p>
			</main>
			<footer>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="7.36 -1.50 75.29 111.22" fill="none" aria-hidden="true" focusable="false">
			<path d="M59.9579 41.315L73.7477 29.9708C75.7741 28.3039 75.6737 25.1702 73.5448 23.6364L45.9499 3.75461C44.5849 2.77111 42.7504 2.74691 41.3598 3.69406L18.7912 19.0667C9.63907 25.3007 9.4343 38.723 18.392 45.2333L40.2842 61.1441" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"/>
			<path d="M44.0316 68.1163C42.047 68.1163 40.4105 66.4896 40.4105 64.4493C40.4107 62.4092 42.0471 60.7833 44.0316 60.7833C46.0162 60.7833 47.6525 62.4092 47.6527 64.4493C47.6527 66.4897 46.0163 68.1163 44.0316 68.1163Z" stroke="#FFFFFF" stroke-width="4"/>
			<path d="M33.2947 41.8663L23.8719 35.1245C21.6184 33.5122 21.6471 30.1526 23.9278 28.579L33.2947 22.1163" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"/>
			<path d="M30.0421 66.9177L16.2523 78.2618C14.2259 79.9288 14.3263 83.0624 16.4552 84.5963L44.0501 104.478C45.4151 105.462 47.2496 105.486 48.6402 104.539L71.2088 89.166C80.3609 82.932 80.5657 69.5097 71.608 62.9994L49.7158 47.0886" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"/>
			<path d="M45.9684 40.1163C47.953 40.1164 49.5895 41.743 49.5895 43.7833C49.5893 45.8235 47.9529 47.4493 45.9684 47.4493C43.9838 47.4493 42.3475 45.8235 42.3473 43.7833C42.3473 41.743 43.9837 40.1163 45.9684 40.1163Z" stroke="#FFFFFF" stroke-width="4"/>
			<path d="M56.7053 66.3663L66.1281 73.1082C68.3816 74.7205 68.3529 78.0801 66.0722 79.6536L56.7053 86.1163" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"/>
			</svg>
			<span>Di-host di Sakala</span>
			</footer>
			</body>
			</html>
			NOT_FOUND 404
	}
}
