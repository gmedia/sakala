{
	# The agent reaches the admin endpoint only through `docker exec`. Port 2019 is
	# not published to the host or any network.
	admin localhost:2019
	auto_https off

	# Request counters per project host. The agent reads them from the admin
	# endpoint to put idle projects to sleep when the operator enables it
	# (SAKALA_PROJECT_IDLE_SLEEP_MINUTES). Never published or exported.
	metrics {
		per_host
	}

	# Only the public edge may vouch for the visitor. It terminates TLS and sets
	# X-Forwarded-For, -Proto, and -Host from its TCP connection, so the router
	# keeps those headers only when they come from the edge's address and
	# overwrites them for any other peer.
	#
	# SAKALA_RUNTIME_TRUSTED_PROXIES is the subnet of the sakala-runtime network,
	# which holds only the edge and this router (docs/configuration.md). Never
	# trust private_ranges or another broad range: the agent connects this router
	# to every project's network, so a workload could then send a forged
	# X-Forwarded-For to another project's app, for example to get around a rate
	# limit per IP address. An empty value trusts nobody.
	#
	# trusted_proxies_strict reads X-Forwarded-For from right to left, so a value
	# a client put at the left is never taken as the client address.
	servers {
		trusted_proxies static {$SAKALA_RUNTIME_TRUSTED_PROXIES}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

# The agent writes one validated route per project into this read-only mount,
# then validates and reloads this container.
import /etc/caddy/sites/*.Caddyfile

:80 {
	handle /healthz {
		respond "ok" 200
	}

	# An unknown hostname must never look deployed. The header lets the edge tell
	# this answer apart from a project's own 404 when deciding whether a hostname
	# may get a certificate (caddy/edge.Caddyfile).
	handle {
		header X-Sakala-Route missing
		respond "Not found" 404
	}
}
