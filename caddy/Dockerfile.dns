# syntax=docker/dockerfile:1.7

# The edge with a DNS provider module, for a wildcard certificate on
# *.run.<domain> (SAKALA_TLS_MODE=dns). install.sh builds it on the server:
#
#   docker build -f caddy/Dockerfile.dns --build-arg DNS_MODULE=github.com/caddy-dns/cloudflare@v0.2.4 .
#
# Keep both images on the Caddy version of SAKALA_CADDY_IMAGE in versions.env.
# xcaddy fetches the module through the Go module proxy, which checks it against
# the Go checksum database.
FROM caddy:2.11.7-builder-alpine@sha256:95a5e7e2692b5eb9545aadc5b90a39f6f509bee59c9508a493f83ee902eaef63 AS build

ARG DNS_MODULE
RUN test -n "$DNS_MODULE" && xcaddy build --with "$DNS_MODULE"

FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5

COPY --from=build /usr/bin/caddy /usr/bin/caddy
